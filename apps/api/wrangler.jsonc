{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nagare",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "nagare.trkw.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagare",
      // `wrangler d1 create nagare` で表示されるIDに置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Web版（apps/web）のビルド結果。/api・/mcp・/health 以外はSPAとして返す
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/health", "/__scheduled"]
  },
  // 翻訳の既定エンジン。ANTHROPIC_API_KEY（wrangler secret put）があればClaudeを使う
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
